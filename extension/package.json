{
  "name": "@tracklet/extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --configLoader runner",
    "dev": "vite build --watch --mode development --configLoader runner",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.e2e.json",
    "build:release": "node ../scripts/preflight.mjs extension && vite build --mode release --configLoader runner"
  },
  "dependencies": {
    "@tracklet/shared": "*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.2"
  },
  "version": "0.1.0"
}
