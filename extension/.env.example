# Copy to .env.local (gitignored). Both values are public identifiers, not secrets.
# Chrome Extension OAuth client ID (Google Cloud > Credentials). No client secret exists or is needed.
TRACKLET_OAUTH_CLIENT_ID=
# Tracklet backend origin. https required except loopback (http://127.0.0.1:8787 for wrangler dev).
TRACKLET_API_BASE=http://127.0.0.1:8787
